  function countBy(data, field) {
    return data.reduce((acc, item) => {
      const key = item[field] || 'Non renseigné';
      acc[key] = (acc[key] || 0) + 1;
      return acc;
    }, {});
  }

  function averageBy(data, categoryField, valueField) {
    const groups = {};

    data.forEach(item => {
      const key = item[categoryField] || 'Non renseigné';
      const value = toNumber(item[valueField]);

      if (value <= 0) return;

      if (!groups[key]) groups[key] = [];
      groups[key].push(value);
    });

    const result = {};

    Object.keys(groups).forEach(key => {
      result[key] = average(groups[key]);
    });

    return result;
  }

  function averageByTime(data, valueField) {
    const groups = {};

    data.forEach(item => {
      const key = getPeriodKey(item);

      if (!key) return;

      const value = toNumber(item[valueField]);

      if (value <= 0) return;

      if (!groups[key]) groups[key] = [];
      groups[key].push(value);
    });

    const result = {};

    Object.keys(groups).forEach(key => {
      result[key] = average(groups[key]);
    });

    return result;
  }

  function getPeriodKey(item) {
    const year = getYear(item.date_saisie);
    const trimestre = item.periode_trimestre || '';

    if (!year && !trimestre) return '';

    return trimestre ? `${year}-${trimestre}` : year;
  }

  function comparePeriodKeys(a, b) {
    const parse = value => {
      const text = String(value || '');
      const yearMatch = text.match(/(\d{4})/);
      const quarterMatch = text.match(/T([1-4])/i);

      return {
        year: yearMatch ? Number(yearMatch[1]) : 0,
        quarter: quarterMatch ? Number(quarterMatch[1]) : 0
      };
    };

    const pa = parse(a);
    const pb = parse(b);

    if (pa.year !== pb.year) return pa.year - pb.year;
    return pa.quarter - pb.quarter;
  }


  function median(values) {
    const clean = values.filter(v => Number.isFinite(Number(v))).map(Number).sort((a, b) => a - b);

    if (!clean.length) return 0;

    const mid = Math.floor(clean.length / 2);

    return clean.length % 2
      ? clean[mid]
      : (clean[mid - 1] + clean[mid]) / 2;
  }

  function minValue(values) {
    const clean = values.filter(v => Number.isFinite(Number(v))).map(Number);
    return clean.length ? Math.min(...clean) : 0;
  }

  function maxValue(values) {
    const clean = values.filter(v => Number.isFinite(Number(v))).map(Number);
    return clean.length ? Math.max(...clean) : 0;
  }

  function formatMoneyPerM2(value) {
    const n = toNumber(value);
    if (!n) return '—';
    return Math.round(n).toLocaleString('fr-FR') + ' TND/m²';
  }

  function formatPercent(value) {
    const n = toNumber(value);
    if (!n) return '—';
    return n.toLocaleString('fr-FR', {
      maximumFractionDigits: 1
    }) + ' %';
  }


  function average(values) {
    if (!values.length) return 0;
    return values.reduce((sum, value) => sum + value, 0) / values.length;
  }

  function toNumber(value) {
    return Number(value) || 0;
  }

  function formatNumber(value) {
    const n = toNumber(value);
    if (!n) return '—';
    return n.toLocaleString('fr-FR');
  }

  function formatMoney(value) {
    const n = toNumber(value);
    if (!n) return '—';
    return Math.round(n).toLocaleString('fr-FR') + ' TND';
  }

  function getYear(value) {
    if (!value) return '';

    const textValue = String(value).trim();

    const directMatch = textValue.match(/^(\d{4})/);
    if (directMatch) {
      return directMatch[1];
    }

    const parsedDate = new Date(textValue);
    if (!isNaN(parsedDate.getTime())) {
      return String(parsedDate.getFullYear());
    }

    return '';
  }



