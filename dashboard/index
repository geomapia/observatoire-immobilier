  function getMaxMetricValue(data, metric) {
    if (metric === 'count') return 1;

    const values = data
      .map(item => toNumber(item[metric]))
      .filter(value => value > 0);

    return values.length ? Math.max(...values) : 1;
  }

  function getHeatIntensity(item, metric, maxValue) {
    if (metric === 'count') {
      return 0.72;
    }

    const value = toNumber(item[metric]);

    if (!value || !maxValue) {
      return 0.18;
    }

    return Math.max(0.18, Math.min(1, value / maxValue));
  }

  function getHeatStyle(intensity) {
    if (intensity >= 0.78) {
      return { color: '#ef4444', opacity: 0.58 };
    }

    if (intensity >= 0.52) {
      return { color: '#f59e0b', opacity: 0.50 };
    }

    if (intensity >= 0.30) {
      return { color: '#22c55e', opacity: 0.42 };
    }

    return { color: '#0ea5e9', opacity: 0.34 };
  }

